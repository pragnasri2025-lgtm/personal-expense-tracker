# Server Port (Render automatically injects PORT; local default is 3000)
PORT="3000"

# Runtime Mode ('production' on Render, 'development' locally)
NODE_ENV="development"

# Secret key for signing authentication session cookies & tokens
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional SQLite database file path (e.g., /var/data/expense_tracker.db on a Render Persistent Disk)
DB_PATH="./data/expense_tracker.db"

# GEMINI_API_KEY: Optional (if AI features are added later)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed service
APP_URL="MY_APP_URL"
